{
  "$comment": "GENERATED by catalog/export_examples.py from the Showcase app. Do not edit: run the script. Each entry is a real block taken from a definition that passes the gate, so it is correct by construction rather than by review.",
  "source": {
    "app": "showcase",
    "version": "1.2.0"
  },
  "examples": {
    "action": {
      "from": "the detail of 'Capability'",
      "block": {
        "kind": "action",
        "command": "retire_it",
        "style": "danger",
        "icon": "alert"
      }
    },
    "answers": {
      "from": "the detail of 'Suggestion'",
      "block": {
        "kind": "answers",
        "label": "What the requester wrote",
        "via": "submission"
      }
    },
    "avatar": {
      "from": "the detail of 'Session'",
      "block": {
        "kind": "avatar",
        "field": "host",
        "size": "md"
      }
    },
    "board": {
      "from": "the detail of 'Product area'",
      "block": {
        "kind": "board",
        "groupField": "status",
        "sumField": "effort",
        "openDetail": true,
        "newButton": true,
        "cardFields": [
          "owner",
          "family",
          "effort"
        ],
        "source": {
          "entity": "capability",
          "via": "area"
        }
      }
    },
    "calendar": {
      "from": "the detail of 'Capability'",
      "block": {
        "kind": "calendar",
        "label": "Sessions about this",
        "startField": "starts_at",
        "endField": "ends_at",
        "labelField": "title",
        "colorField": "kind",
        "range": "month",
        "openDetail": true,
        "source": {
          "entity": "session",
          "via": "capability"
        }
      }
    },
    "card": {
      "from": "page 'Interactivity'",
      "block": {
        "kind": "card",
        "width": 200,
        "padding": "sm",
        "bordered": true,
        "tint": "family",
        "minHeight": 48,
        "openDetail": true,
        "blocks": [
          {
            "kind": "field",
            "field": "name",
            "size": "sm"
          }
        ]
      }
    },
    "cell": {
      "from": "page 'Interactivity'",
      "block": {
        "kind": "cell",
        "entity": "fit",
        "field": "level",
        "editable": true,
        "placeholder": "-",
        "keys": {
          "capability": "{{row.id}}",
          "persona": "{{col.id}}"
        }
      }
    },
    "chart": {
      "from": "page 'Sessions'",
      "block": {
        "kind": "chart",
        "chartType": "bar",
        "label": "Sessions by kind",
        "source": {
          "entity": "session",
          "aggregate": {
            "op": "count",
            "groupBy": "kind"
          }
        }
      }
    },
    "child": {
      "from": "the detail of 'Session'",
      "block": {
        "kind": "child",
        "entity": "attendee",
        "via": "session",
        "childType": "chips",
        "label": "Attendees"
      }
    },
    "chip": {
      "from": "page 'Areas'",
      "block": {
        "kind": "chip",
        "field": "code"
      }
    },
    "columns": {
      "from": "page 'Readiness'",
      "block": {
        "kind": "columns",
        "gap": "md",
        "columns": [
          [
            {
              "kind": "chart",
              "chartType": "bar",
              "label": "Readiness by persona",
              "source": {
                "entity": "fit",
                "aggregate": {
                  "op": "count",
                  "groupBy": "persona"
                }
              }
            }
          ],
          [
            {
              "kind": "chart",
              "chartType": "donut",
              "label": "Readiness overall",
              "source": {
                "entity": "fit",
                "aggregate": {
                  "op": "count",
                  "groupBy": "level"
                }
              }
            }
          ]
        ]
      }
    },
    "control": {
      "from": "page 'Roadmap'",
      "block": {
        "kind": "control",
        "control": "segmented",
        "stateKey": "mode"
      }
    },
    "create": {
      "from": "page 'Readiness'",
      "block": {
        "kind": "create",
        "entity": "capability",
        "label": "New capability"
      }
    },
    "documents": {
      "from": "page 'Library'",
      "block": {
        "kind": "documents"
      }
    },
    "field": {
      "from": "the detail of 'Release'",
      "block": {
        "kind": "field",
        "field": "theme"
      }
    },
    "fields": {
      "from": "the detail of 'Session'",
      "block": {
        "kind": "fields",
        "cols": 1,
        "hideEmpty": true,
        "fields": [
          "room",
          "seats",
          "capability"
        ]
      }
    },
    "filterbar": {
      "from": "page 'Readiness'",
      "block": {
        "kind": "filterbar",
        "entity": "capability",
        "facets": [
          {
            "field": "family",
            "state": "f_family",
            "label": "Family"
          }
        ]
      }
    },
    "form": {
      "from": "the detail of 'Capability'",
      "block": {
        "kind": "form",
        "entity": "note",
        "via": "capability"
      }
    },
    "gantt": {
      "from": "the detail of 'Release'",
      "block": {
        "kind": "gantt",
        "label": "Work in this release",
        "startField": "started_on",
        "endField": "shipped_on",
        "labelField": "name",
        "colorField": "status",
        "openDetail": true,
        "interaction": "visualization",
        "source": {
          "entity": "capability",
          "via": "release"
        }
      }
    },
    "grid": {
      "from": "the detail of 'Capability'",
      "block": {
        "kind": "grid",
        "cols": 2,
        "gap": "sm",
        "blocks": [
          {
            "kind": "chip",
            "field": "family"
          },
          {
            "kind": "chip",
            "field": "maturity"
          },
          {
            "kind": "chip",
            "field": "surface"
          },
          {
            "kind": "chip",
            "value": "{block_kind}"
          }
        ]
      }
    },
    "history": {
      "from": "the detail of 'Release'",
      "block": {
        "kind": "history"
      }
    },
    "hub": {
      "from": "the peek of 'Capability'",
      "block": {
        "kind": "hub",
        "title": "name",
        "status": "status",
        "subtitle": [
          "authoring_name"
        ],
        "facts": [
          "family",
          "owner",
          "effort"
        ],
        "actions": [
          "edit"
        ]
      }
    },
    "intake": {
      "from": "page 'Requests'",
      "block": {
        "kind": "intake",
        "entity": "request_form",
        "filters": [
          {
            "field": "active",
            "operator": "eq",
            "value": true
          }
        ]
      }
    },
    "matrix": {
      "from": "page 'Interactivity'",
      "block": {
        "kind": "matrix",
        "class": "mt-3",
        "label": "Tasks due in the window, by person",
        "emptyText": "Nobody has a task due in this window.",
        "source": {
          "entity": "task",
          "aggregate": {
            "op": "count"
          }
        },
        "rowBy": "assignee",
        "columnBy": "due_on",
        "columnSource": {
          "dates": {
            "from": "{{state.window.from}}",
            "to": "{{state.window.to}}",
            "step": "day"
          }
        },
        "totals": {
          "rows": true,
          "columns": true
        }
      }
    },
    "orgchart": {
      "from": "page 'Team'",
      "block": {
        "kind": "orgchart",
        "entity": "contributor",
        "manager": "reports_to",
        "identity": "person",
        "subtitle": "title"
      }
    },
    "period": {
      "from": "page 'Calculation'",
      "block": {
        "kind": "period",
        "stateKey": "year",
        "class": "mt-2"
      }
    },
    "process": {
      "from": "the detail of 'Capability'",
      "block": {
        "kind": "process"
      }
    },
    "progress": {
      "from": "the peek of 'Capability'",
      "block": {
        "kind": "progress",
        "label": "Adoption",
        "field": "adoption_pct",
        "max": "adoption_target"
      }
    },
    "relatedApps": {
      "from": "the detail of 'Capability'",
      "block": {
        "kind": "relatedApps",
        "empty": "No other app in this workspace points at this record yet."
      }
    },
    "repeat": {
      "from": "page 'Interactivity'",
      "block": {
        "kind": "repeat",
        "as": "head",
        "direction": "row",
        "gap": "none",
        "source": {
          "entity": "persona",
          "sort": [
            {
              "field": "position",
              "direction": "asc"
            }
          ]
        },
        "blocks": [
          {
            "kind": "stack",
            "width": 130,
            "padding": "sm",
            "bordered": true,
            "align": "center",
            "blocks": [
              {
                "kind": "field",
                "field": "name",
                "size": "sm",
                "weight": "bold"
              }
            ]
          }
        ]
      }
    },
    "row": {
      "from": "page 'Interactivity'",
      "block": {
        "kind": "row",
        "align": "center",
        "gap": "sm",
        "blocks": [
          {
            "kind": "text",
            "value": "A quick look",
            "weight": "bold",
            "icon": "open-in-app",
            "grow": true
          }
        ]
      }
    },
    "section": {
      "from": "the detail of 'Session'",
      "block": {
        "kind": "section",
        "label": "Agenda",
        "icon": "clipboard-list",
        "edit": [
          "agenda"
        ],
        "blocks": [
          {
            "kind": "field",
            "field": "agenda"
          }
        ]
      }
    },
    "settings": {
      "from": "page 'Configuration'",
      "block": {
        "kind": "settings",
        "entity": "showcase_settings"
      }
    },
    "split": {
      "from": "page 'Interactivity'",
      "block": {
        "kind": "split",
        "as": "sugg",
        "class": "mt-2",
        "fields": [
          "title",
          "priority",
          "verdict"
        ],
        "emptyText": "Nothing waiting.",
        "source": {
          "entity": "suggestion",
          "sort": [
            {
              "field": "raised_on",
              "direction": "desc"
            }
          ]
        },
        "blocks": [
          {
            "kind": "stack",
            "gap": "md",
            "padding": "md",
            "blocks": [
              {
                "kind": "row",
                "align": "center",
                "gap": "sm",
                "blocks": [
                  {
                    "kind": "field",
                    "field": "title",
                    "size": "lg",
                    "weight": "bold",
                    "grow": true
                  },
                  {
                    "kind": "chip",
                    "field": "verdict"
                  }
                ]
              },
              {
                "kind": "field",
                "field": "detail"
              },
              {
                "kind": "row",
                "gap": "sm",
                "class": "mt-2",
                "blocks": [
                  {
                    "kind": "action",
                    "command": "accept_suggestion",
                    "style": "primary",
                    "icon": "check-circle"
                  },
                  {
                    "kind": "action",
                    "command": "decline_suggestion",
                    "style": "danger",
                    "icon": "alert-circle"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    "stack": {
      "from": "page 'Look and feel'",
      "block": {
        "kind": "stack",
        "width": 8,
        "minHeight": 96,
        "class": "bg-deep-purple",
        "blocks": [
          {
            "kind": "text",
            "value": "",
            "size": "xs"
          }
        ]
      }
    },
    "stat": {
      "from": "page 'Triage'",
      "block": {
        "kind": "stat",
        "label": "Area",
        "field": "area"
      }
    },
    "table": {
      "from": "page 'Automation'",
      "block": {
        "kind": "table",
        "class": "mt-2",
        "openDetail": true,
        "fields": [
          "name",
          "number",
          "phase",
          "notes_public"
        ],
        "source": {
          "entity": "release"
        }
      }
    },
    "tabs": {
      "from": "the detail of 'Product area'",
      "block": {
        "kind": "tabs",
        "tabs": [
          {
            "key": "board",
            "label": "Board",
            "blocks": [
              {
                "kind": "board",
                "groupField": "status",
                "sumField": "effort",
                "openDetail": true,
                "newButton": true,
                "cardFields": [
                  "owner",
                  "family",
                  "effort"
                ],
                "source": {
                  "entity": "capability",
                  "via": "area"
                }
              }
            ]
          },
          {
            "key": "charter",
            "label": "Charter",
            "blocks": [
              {
                "kind": "section",
                "label": "What this area owns",
                "icon": "book-open",
                "edit": [
                  "charter",
                  "blurb",
                  "docs_folder"
                ],
                "blocks": [
                  {
                    "kind": "field",
                    "field": "charter"
                  }
                ]
              }
            ]
          },
          {
            "key": "trend",
            "label": "Trend",
            "blocks": [
              {
                "kind": "chart",
                "chartType": "area",
                "label": "Shipped to date",
                "source": {
                  "entity": "adoption",
                  "via": "area",
                  "aggregate": {
                    "op": "sum",
                    "field": "running_shipped",
                    "groupBy": "month_of:month"
                  }
                }
              },
              {
                "kind": "table",
                "label": "By month",
                "class": "mt-4",
                "fields": [
                  "month",
                  "shipped",
                  "running_shipped",
                  "apps_using"
                ],
                "source": {
                  "entity": "adoption",
                  "via": "area",
                  "sort": [
                    {
                      "field": "month",
                      "direction": "asc"
                    }
                  ]
                }
              }
            ]
          },
          {
            "key": "people",
            "label": "People",
            "blocks": [
              {
                "kind": "child",
                "entity": "contributor",
                "via": "area",
                "childType": "table",
                "label": "Contributors",
                "fields": [
                  "person",
                  "title",
                  "owned_count"
                ]
              }
            ]
          }
        ]
      }
    },
    "text": {
      "from": "page 'Overview'",
      "block": {
        "kind": "text",
        "value": "",
        "size": "xs"
      }
    },
    "tiles": {
      "from": "the detail of 'Release'",
      "block": {
        "kind": "tiles",
        "tiles": [
          {
            "label": "Budget",
            "field": "budget",
            "format": "money",
            "icon": "bank"
          },
          {
            "label": "Committed",
            "field": "committed",
            "format": "share",
            "max": "budget",
            "icon": "cash",
            "attention": {
              "op": "gt",
              "value": 0.9
            }
          },
          {
            "label": "Milestones",
            "field": "milestone_count",
            "icon": "flag"
          },
          {
            "label": "Capabilities in it",
            "field": "capability_count",
            "icon": "shape"
          },
          {
            "label": "Effort planned",
            "field": "effort_planned",
            "icon": "briefcase"
          }
        ]
      }
    },
    "timeline": {
      "from": "page 'Roadmap'",
      "block": {
        "kind": "timeline",
        "entity": "capability",
        "rowBy": "area",
        "startField": "started_on",
        "endField": "shipped_on",
        "labelField": "name",
        "colorField": "status",
        "openDetail": true,
        "axis": {
          "from": "{{state.cursor}}",
          "range": "year"
        }
      }
    },
    "view": {
      "from": "page 'Capabilities'",
      "block": {
        "kind": "view",
        "view": "shipped_blocks"
      }
    }
  }
}
