<Project>

  <!--
    Where each project puts obj/ and bin/.

    THE PROBLEM THIS SOLVES. A host may bind-mount this repository into a container that runs
    `dotnet watch` while a developer also builds the same tree from the host. Both SDKs then build the
    SAME source into the SAME obj/ directories and corrupt each other: NuGet's
    `project.assets.json already exists`, and MSBuild's `ResolvePackageAssets` failing to read its own
    cache file.

    WITH CORDANGO_BUILD_ROOT SET, intermediate and output paths move to a container-local volume and
    the bind-mounted tree is never written to. WITHOUT it (a developer's machine, CI, a plain clone),
    nothing changes and obj/bin sit where every .NET tool expects them.

    It has to live in Directory.Build.props rather than each .csproj: BaseIntermediateOutputPath is
    read during restore, before the SDK's own props are imported, and setting it any later is silently
    ignored for restore while still applying to build, which produces a worse failure than the one it
    fixes.
  -->
  <PropertyGroup Condition="'$(CORDANGO_BUILD_ROOT)' != ''">
    <BaseIntermediateOutputPath>$(CORDANGO_BUILD_ROOT)/$(MSBuildProjectName)/obj/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(CORDANGO_BUILD_ROOT)/$(MSBuildProjectName)/bin/</BaseOutputPath>

    <!--
      And exclude the CONVENTIONAL obj/bin, which is no longer excluded automatically.

      The SDK's default source glob skips $(BaseIntermediateOutputPath) and $(BaseOutputPath). Move
      those elsewhere and the ordinary ./obj suddenly looks like ordinary source: a container reading
      the bind-mounted tree compiles the host's leftover generated AssemblyInfo.cs alongside its own
      and fails with CS0579 "duplicate attribute", an error that names a file nobody wrote and points
      at neither cause.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <!--
    WHAT EVERY PUBLISHED PACKAGE SAYS ABOUT ITSELF.

    Here rather than repeated in each csproj, because the licence, the URLs and the author are facts
    about the repository rather than about any one package.

    PACKING IS OFF BY DEFAULT and the two published projects turn it on. That is the opposite of the
    SDK's default, which packs every library — and the SDK's default is exactly how the compiler and
    the generator SDK came to produce packages nobody meant to publish, versioned 1.0.0 because they
    had no <Version> of their own to take. Two published packages is the whole set:

      Cordango.Cli         the tool. Contains the compiler, the generator SDK and the dotnet-vue
                           generator as FILES, and declares no dependencies at all.
      Cordango.Standalone  the runtime a generated application references.

    THE RELEASED VERSION COMES FROM THE GIT TAG, overriding the default below.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>

    <!--
      ONE VERSION FOR EVERY ASSEMBLY IN THIS REPOSITORY, packed or not.

      Not just the two packages: the generator stamps its own assembly version into every generated
      application's build metadata, and it writes the Cordango.Standalone version into the project
      file it emits. Left to the SDK's default those assemblies are 1.0.0, so a locally built
      generator would tell a user to reference a runtime version that does not exist — which is the
      bug this whole arrangement exists to prevent, reintroduced one level down.

      The release workflow passes -p:Version=<tag> on the command line, which is a global property
      and therefore applies to every project in the build graph, packed or merely referenced. So a
      released build and a local build differ in the NUMBER and never in where it came from.
    -->
    <Version>0.7.3</Version>

    <Authors>Cordango</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/cordango/cordango</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cordango/cordango</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Records the commit in the package so a released artifact can be traced back to the source
         that produced it. Set by the workflow; harmless locally. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <!--
    DO NOT set CORDANGO_BUILD_ROOT to run TESTS. It is for app hosts only.

    `Corpus.RepoRoot()` finds the repository by walking up from the test assembly's location, so an
    output directory outside the repo makes it throw and takes every corpus-driven theory down with
    it. Said here because the failure names a missing repo root and gives no hint that an environment
    variable caused it.
  -->

</Project>
