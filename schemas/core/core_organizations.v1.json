      "blocks": [
        {
          "kind": "stack",
          "gap": "md",
          "blocks": [
            {
              "kind": "filterbar",
              "entity": "organization",
              "search": {
                "state": "q",
                "placeholder": "Search companies…"
              },
              "facets": [
                {
                  "state": "roles",
                  "field": "roles"
                },
                {
                  "state": "industry",
                  "field": "industry"
                },
                {
                  "state": "country",
                  "field": "country"
                },
                {
                  "state": "owner",
                  "field": "owner"
                },
                {
                  "state": "status",
                  "field": "status"
                }
              ]
            },
            {
              "kind": "table",
              "newButton": true,
              "openDetail": true,
              "fields": [
                "name",
                "roles",
                "industry",
                "city",
                "country",
                "owner",
                "status"
              ],
              "search": {
                "state": "q",
                "fields": [
                  "name",
                  "city"
                ]
              },
              "source": {
                "entity": "organization",
                "sort": [
                  {
                    "field": "name",
                    "direction": "asc"
                  }
                ],
                "filters": [
                  {
                    "field": "status",
                    "operator": "eq",
                    "value": "{{state.status}}",
                    "optional": true
                  },
                  {
                    "field": "roles",
                    "operator": "contains",
                    "value": "{{state.roles}}",
                    "optional": true
                  },
                  {
                    "field": "industry",
                    "operator": "eq",
                    "value": "{{state.industry}}",
                    "optional": true
                  },
                  {
                    "field": "country",
                    "operator": "eq",
                    "value": "{{state.country}}",
                    "optional": true
                  },
                  {
                    "field": "owner",
                    "operator": "eq",
                    "value": "{{state.owner}}",
                    "optional": true
                  }
                ]
              }
            }
          ]
        }
      ]
    },
