<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Cordango.Standalone.Tests</RootNamespace>

    <!-- Same opt-in a generated application needs: Microsoft.AspNetCore.OpenApi's XML-comment
         source generator emits interceptors, and this project reaches it through the runtime. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.9" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cordango.Compiler\Cordango.Compiler.csproj" />
    <ProjectReference Include="..\..\src\Cordango.Standalone\Cordango.Standalone.csproj" />
    <ProjectReference Include="..\..\src\Cordango.SourceGen.DotNetVue\Cordango.SourceGen.DotNetVue.csproj" />
  </ItemGroup>

</Project>
