# {{AppName}} — what this application reads from its environment.
#
# Copy to .env for local use. `docker compose up` sets what it needs on its own, so this file is
# for running the application directly.

# REQUIRED. Signs the session and antiforgery cookies, and the application will not start without
# one. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Keep it out of the repository and keep it stable: changing it signs everybody out.
APP_SECRET=

# The database. Unset means PGlite in this process, on the local disk — which is what makes
# `npm start` a complete application with nothing to install first. Set it for a real server.
# DATABASE_URL=postgres://{{AppSlug}}:{{AppSlug}}@localhost:5432/{{AppSlug}}

# The port the API listens on.
PORT=5000

# Mark the cookies Secure. Turn this on only once there is TLS in front of the application: over
# plain HTTP the browser will not send a Secure cookie back, and the symptom is a sign-in that
# appears to work and leaves you signed out.
SECURITY_REQUIRE_HTTPS=false

# Honour X-Forwarded-For and X-Forwarded-Proto. On behind a reverse proxy that terminates TLS, off
# otherwise — a trusted proxy header from an untrusted source is a header anybody can set.
SECURITY_BEHIND_PROXY=false

# Load the demo dataset on first start, into empty tables only.
SEED_ENABLED=false
# Set to `today` to re-anchor the demo dates on the day it loads. Makes the data look current and
# makes the run non-reproducible, which is why it is a choice with a name rather than a default.
# SEED_DATE=today

# The first administrator, created on an empty database. Without these, the first person to open
# the application is asked to create one. Set them for a deployment whose first visitor will not
# be you.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Where uploaded files live, and where the built front end is served from.
# STORAGE_PATH=./appdata/media
# WEB_ROOT=./api/public
