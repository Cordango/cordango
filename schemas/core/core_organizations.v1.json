  "entities": [
    {
      "key": "organization",
      "label": "Organization",
      "labelPlural": "Organizations",
      "description": "A company the workspace deals with — a customer, a supplier, a partner, an investor or a holding. The canonical record: an invoice, a deal and a timesheet all point at THIS row rather than each app keeping its own spelling of the name.",
      "icon": "domain",
      "displayField": "name",
      "fields": [
        {
          "key": "name",
          "label": "Name",
          "type": "text",
          "required": true,
          "indexed": true
        },
        {
          "key": "roles",
          "label": "Relationship",
          "type": "multiselect",
          "help": "What this company IS to us. Deliberately multi-valued and deliberately durable: a supplier is often also a customer, a prospect is often already a supplier, and none of those facts expires. Where a company sits in a sales PROCESS is the CRM's business — that lives on the deal, not here.",
          "options": [
            {
              "value": "prospect",
              "label": "Prospect",
              "color": "#0ea5e9"
            },
            {
              "value": "customer",
              "label": "Customer",
              "color": "#16a34a"
            },
            {
              "value": "vendor",
              "label": "Vendor",
              "color": "#f59e0b"
            },
            {
              "value": "partner",
              "label": "Partner",
              "color": "#8b5cf6"
            },
            {
              "value": "investor",
              "label": "Investor",
              "color": "#0891b2"
            },
            {
              "value": "portfolio",
              "label": "Portfolio company",
              "color": "#ec4899"
            }
          ]
        },
        {
          "key": "status",
          "label": "Status",
          "type": "select",
          "role": "status",
          "default": "active",
          "indexed": true,
          "help": "Archived companies stay resolvable — a reference from an old invoice must still render a name — but drop out of pickers and lists by default.",
          "options": [
            {
              "value": "active",
              "label": "Active",
              "color": "#16a34a",
              "phase": "active"
            },
            {
              "value": "archived",
