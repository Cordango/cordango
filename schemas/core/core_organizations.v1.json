  "roles": [
    {
      "key": "viewer",
      "name": "Viewer",
      "description": "Every member of the workspace. Reads the directory so a company reference resolves to a name on their own records, and cannot change it.",
      "grants": [
        {
          "entity": "organization",
          "read": true,
          "fieldOverrides": [
            {
              "field": "notes",
              "read": false
            }
          ]
        },
        {
          "entity": "contact",
          "read": true,
          "fieldOverrides": [
            {
              "field": "notes",
              "read": false
            }
          ]
        }
      ]
    },
    {
      "key": "editor",
      "name": "Editor",
      "description": "Maintains the directory: adds companies and contacts, corrects them, and archives the ones that are no longer current. Nobody deletes — a deleted company would strand every record pointing at it.",
      "grants": [
        {
          "entity": "organization",
          "read": true,
          "create": true,
          "update": true
        },
        {
          "entity": "contact",
          "read": true,
          "create": true,
          "update": true
        }
      ]
    }
  ],
