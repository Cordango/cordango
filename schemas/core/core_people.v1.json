{
  "schemaVersion": "2.0",
  "key": "core_people",
  "name": "People",
  "version": "1.0.0",
  "description": "Who works here, and everything a company needs to keep about them: the employee record, employment history, compensation, emergency contacts, documents and HR notes. Provided by the platform in every workspace, so an app that needs to point at a colleague has something real to point at instead of inventing its own staff list. Onboarding and offboarding are deliberately NOT here — those are a process every company runs differently, and they belong to an HR app built for the way this one runs them.",
  "presentation": {
    "icon": "account-group",
    "color": "#4f46e5",
    "category": "Core",
    "tagline": "Who works here, and their records"
  },
