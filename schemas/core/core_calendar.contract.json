    "contractHash": "c1e2b41ef1f71e51b00c6c4190f8f01ee285c92777ffce899391d27851048ece"
  },
  "entities": [
    {
      "key": "calendar_source",
      "label": "Calendar",
      "labelPlural": "Calendars",
      "description": "One connected calendar. This is what makes 'I have several calendars' first class rather than a pile of events with a provider column: colour, visibility and the booking target all hang off the source, and turning one off hides its events everywhere at once.",
      "displayField": "name",
      "kind": "config",
      "fields": [
        {
          "key": "name",
          "label": "Name",
          "type": "text",
          "required": true
        },
        {
          "key": "provider",
          "label": "Provider",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "microsoft",
              "label": "Outlook",
              "color": "#0078d4"
            },
            {
              "value": "google",
              "label": "Google",
              "color": "#ea4335"
            },
            {
              "value": "local",
              "label": "Cordango",
              "color": "#0ea5e9"
            },
            {
              "value": "ical",
              "label": "iCal link",
              "color": "#7c3aed"
            }
          ]
        },
        {
          "key": "owner",
          "label": "Owner",
          "type": "reference",
          "required": true,
          "targetApp": "platform",
          "targetEntity": "person"
        },
        {
          "key": "color",
          "label": "Colour",
          "type": "text"
        },
        {
