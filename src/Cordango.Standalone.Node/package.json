{
  "name": "@cordango/standalone",
  "version": "0.0.0",
  "description": "The Cordango standalone runtime for Node: records, permissions, conditions, computed figures, and the HTTP surface a generated application serves.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cordango/cordango.git",
    "directory": "src/Cordango.Standalone.Node"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json --noEmit && vitest run"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8"
  },
  "optionalDependencies": {
    "pg": "*"
  }
}
