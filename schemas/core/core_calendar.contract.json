            },
            {
              "value": "busy",
              "label": "Busy",
              "color": "#4f46e5"
            },
            {
              "value": "out_of_office",
              "label": "Out of office",
              "color": "#dc2626"
            },
            {
              "value": "working_elsewhere",
              "label": "Working elsewhere",
              "color": "#0891b2"
            }
          ]
        },
        {
          "key": "sensitivity",
          "label": "Sensitivity",
          "type": "select",
          "options": [
            {
              "value": "normal",
              "label": "Normal",
              "color": "#94a3b8"
            },
            {
              "value": "private",
              "label": "Private",
              "color": "#f59e0b"
            },
            {
              "value": "confidential",
              "label": "Confidential",
              "color": "#dc2626"
            }
          ]
        },
        {
          "key": "is_cancelled",
          "label": "Cancelled",
          "type": "boolean"
        },
        {
          "key": "origin",
          "label": "Origin",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "imported",
              "label": "Imported",
              "color": "#94a3b8"
            },
            {
              "value": "local",
              "label": "Cordango",
              "color": "#0ea5e9"
            }
          ]
        },
        {
          "key": "external_id",
          "label": "External id",
          "type": "text"
        },
        {
          "key": "external_series_id",
          "label": "Series id",
          "type": "text"
        },
        {
          "key": "external_etag",
          "label": "ETag",
          "type": "text"
        },
        {
          "key": "synced_at",
          "label": "Synced",
          "type": "datetime"
        }
      ]
    },
    {
      "key": "calendar_share",
      "label": "Share",
      "labelPlural": "Shared with",
      "description": "One colleague this calendar is shown to. A calendar is private to its owner and this is the ONLY thing that widens that — there is no role, and no administrator, that reaches somebody else’s calendar without a row here. Sharing is read-only by construction: the entries stay their owner’s to change.",
      "displayField": "person",
      "kind": "config",
      "ownedBy": "calendar_source",
      "fields": [
        {
          "key": "calendar",
          "label": "Calendar",
          "type": "reference",
          "required": true,
          "targetEntity": "calendar_source"
        },
        {
          "key": "person",
          "label": "Colleague",
          "type": "reference",
          "required": true,
          "targetApp": "platform",
          "targetEntity": "person"
        }
      ]
    },
    {
      "key": "event_guest",
      "label": "Guest",
      "labelPlural": "Guests",
      "description": "Somebody invited to an appointment. A child record rather than a field, because there is no multi-reference field type and a multiselect holds only a closed option list — 'several people on one meeting' has no other shape here. It is also the shape Outlook and Google both hand back, so an imported attendee and an invited colleague land in the same place instead of two that disagree.",
      "displayField": "email",
      "ownedBy": "calendar_event",
      "fields": [
        {
          "key": "event",
          "label": "Event",
          "type": "reference",
          "required": true,
          "targetEntity": "calendar_event"
        },
        {
          "key": "email",
          "label": "Email",
          "type": "email",
          "required": true
        },
        {
          "key": "name",
          "label": "Name",
          "type": "text"
        },
        {
          "key": "person",
          "label": "Colleague",
          "type": "reference",
          "targetApp": "platform",
          "targetEntity": "person"
        },
        {
          "key": "response",
          "label": "Response",
          "type": "select",
          "options": [
            {
              "value": "needs_action",
              "label": "No reply",
              "color": "#94a3b8"
            },
            {
              "value": "accepted",
              "label": "Yes",
              "color": "#16a34a"
            },
            {
              "value": "tentative",
              "label": "Maybe",
              "color": "#f59e0b"
            },
            {
              "value": "declined",
              "label": "No",
              "color": "#dc2626"
            }
          ]
        },
        {
          "key": "is_organizer",
          "label": "Organizer",
          "type": "boolean"
        }
      ]
    },
    {
      "key": "booking_page",
      "label": "Booking page",
      "labelPlural": "Booking pages",
      "description": "A shareable link that lets someone outside the workspace pick a free slot. The rules of engagement live here — how long, how much notice, which hours, how much buffer — so the public page computes them rather than being told what to offer.",
      "displayField": "name",
      "fields": [
        {
          "key": "name",
          "label": "Name",
          "type": "text",
          "required": true
        },
        {
          "key": "owner",
          "label": "Owner",
          "type": "reference",
          "required": true,
          "targetApp": "platform",
          "targetEntity": "person"
        },
        {
          "key": "slug",
          "label": "Link",
          "type": "text",
          "required": true
        },
        {
          "key": "description",
          "label": "Description",
          "type": "longtext"
        },
        {
          "key": "duration_minutes",
          "label": "Default length",
          "type": "integer",
          "required": true
        },
        {
          "key": "duration_choices",
          "label": "Lengths offered",
          "type": "multiselect",
          "options": [
            {
              "value": "15",
              "label": "15 min",
              "color": "#3b82f6"
            },
            {
              "value": "30",
              "label": "30 min",
              "color": "#8b5cf6"
            },
            {
              "value": "45",
              "label": "45 min",
              "color": "#06b6d4"
            },
            {
              "value": "60",
              "label": "1 hour",
              "color": "#ec4899"
            },
            {
              "value": "90",
              "label": "1½ hours",
              "color": "#14b8a6"
            },
            {
              "value": "120",
              "label": "2 hours",
              "color": "#f97316"
            }
          ]
        },
        {
          "key": "buffer_before_minutes",
          "label": "Buffer before",
          "type": "integer"
        },
        {
          "key": "buffer_after_minutes",
          "label": "Buffer after",
          "type": "integer"
        },
        {
          "key": "min_notice_hours",
          "label": "Minimum notice",
          "type": "integer"
        },
        {
          "key": "max_days_ahead",
          "label": "How far ahead",
          "type": "integer"
        },
        {
          "key": "time_zone",
          "label": "Time zone",
          "type": "text",
          "required": true
        },
        {
          "key": "availability",
          "label": "When people can book",
          "type": "json"
        },
        {
          "key": "target_calendar",
          "label": "Add bookings to",
          "type": "reference",
          "targetEntity": "calendar_source"
        },
        {
          "key": "location_kind",
          "label": "How you meet",
          "type": "select",
          "options": [
            {
              "value": "online",
              "label": "Online",
              "color": "#0ea5e9"
            },
            {
              "value": "phone",
              "label": "Phone",
              "color": "#16a34a"
            },
            {
              "value": "in_person",
              "label": "In person",
              "color": "#7c3aed"
            }
          ]
        },
        {
          "key": "location_detail",
          "label": "Address, number or link",
          "type": "text"
        },
        {
          "key": "notify_email",
          "label": "Email a copy to",
          "type": "email"
        },
        {
          "key": "is_published",
          "label": "Published",
          "type": "boolean"
        }
      ]
    },
    {
      "key": "booking_contact",
      "label": "Contact",
      "labelPlural": "Contacts",
      "description": "Somebody outside the workspace who booked time. Deliberately an ordinary app record and NOT a platform person: external people are not colleagues, they have no login, no seat and no grants, and minting an account per stranger would be account enumeration wearing a data model.",
      "displayField": "name",
      "kind": "config",
      "fields": [
        {
          "key": "name",
          "label": "Name",
          "type": "text",
          "required": true
        },
        {
          "key": "email",
          "label": "Email",
          "type": "email",
          "required": true
        },
        {
          "key": "phone",
          "label": "Phone",
          "type": "phone"
        },
        {
          "key": "company",
          "label": "Company",
          "type": "text"
        },
        {
          "key": "first_seen_at",
          "label": "First booked",
          "type": "datetime"
        },
        {
          "key": "contact",
          "label": "Contact",
          "type": "reference",
          "targetApp": "core_people",
          "targetEntity": "contact"
        }
      ]
    },
    {
      "key": "booking",
      "label": "Booking",
      "labelPlural": "Bookings",
      "description": "One appointment somebody booked through a public page. Stays 'pending' until the emailed link is clicked — which is both correct behaviour and the strongest cheap defence there is, because it costs a spammer a working mailbox per attempt.",
      "displayField": "summary",
      "fields": [
        {
          "key": "summary",
          "label": "Summary",
          "type": "text",
          "required": true
        },
        {
          "key": "page",
          "label": "Booking page",
          "type": "reference",
          "required": true,
          "targetEntity": "booking_page"
        },
        {
          "key": "contact",
          "label": "Booked by",
          "type": "reference",
          "required": true,
          "targetEntity": "booking_contact"
        },
        {
          "key": "starts_at",
          "label": "Starts",
          "type": "datetime",
          "required": true
        },
        {
          "key": "ends_at",
          "label": "Ends",
          "type": "datetime",
          "required": true
        },
        {
          "key": "status",
          "label": "Status",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "pending",
              "label": "Awaiting confirmation",
              "color": "#f59e0b"
            },
            {
              "value": "confirmed",
              "label": "Confirmed",
              "color": "#16a34a"
            },
            {
              "value": "cancelled",
              "label": "Cancelled",
              "color": "#94a3b8"
            }
          ]
        },
        {
          "key": "note",
          "label": "Note",
          "type": "longtext"
        },
        {
          "key": "visitor_time_zone",
          "label": "Visitor time zone",
          "type": "text"
        },
        {
          "key": "confirmed_at",
          "label": "Confirmed",
          "type": "datetime"
        },
        {
          "key": "cancelled_at",
          "label": "Cancelled",
          "type": "datetime"
        },
        {
          "key": "write_back_state",
          "label": "In calendar",
          "type": "select",
          "options": [
            {
              "value": "not_applicable",
              "label": "Not applicable",
              "color": "#94a3b8"
            },
            {
              "value": "pending",
              "label": "Pending",
              "color": "#f59e0b"
            },
            {
              "value": "done",
              "label": "Created",
              "color": "#16a34a"
            },
            {
              "value": "failed",
              "label": "Failed",
              "color": "#dc2626"
            }
          ]
        },
        {
          "key": "calendar_event",
          "label": "Calendar entry",
          "type": "reference",
          "targetEntity": "calendar_event"
        },
        {
          "key": "write_back_error",
          "label": "Write-back error",
          "type": "longtext"
        },
        {
          "key": "external_event_id",
          "label": "External event id",
          "type": "text"
        }
      ]
    }
  ],
  "dependencies": [
    {
      "app": "core_people",
      "entities": [
        "contact"
      ],
      "source": "both",
      "fields": [
        "booking_contact.contact"
      ],
      "why": "A visitor who confirms a booking becomes a contact"
    },
    {
      "app": "platform",
      "entities": [
        "person"
      ],
      "source": "reference",
      "fields": [
        "booking_page.owner",
        "calendar_share.person",
        "calendar_source.owner",
        "event_guest.person"
      ]
    }
  ],
  "eventDefaults": {
    "crud": true,
    "kinds": [
      "record.created",
      "record.updated",
      "record.deleted"
    ],
    "note": "Every entity emits <entity>.created, <entity>.updated and <entity>.deleted. The events list carries only what this rule does not already say."
  },
  "actions": [
    {
      "id": "booking_page.publish",
      "key": "publish",
      "entity": "booking_page",
      "label": "Publish",
      "description": "Make the link answer. Until it is published the address behaves as if the page did not exist.",
      "requires": [
        "booking_page.publish.when"
      ]
    },
    {
      "id": "booking_page.unpublish",
      "key": "unpublish",
      "entity": "booking_page",
      "label": "Unpublish",
      "description": "Stop taking bookings. Appointments already made are untouched — this only closes the door, it does not cancel anybody.",
      "requires": [
        "booking_page.unpublish.when"
      ]
    }
  ],
  "rules": [
    {
      "id": "booking_page.publish.when",
      "entity": "booking_page",
      "on": [
        "command:publish"
      ],
      "kind": "guard",
      "effect": "stop",
      "source": "synthesized"
    },
    {
      "id": "booking_page.unpublish.when",
      "entity": "booking_page",
      "on": [
        "command:unpublish"
      ],
      "kind": "guard",
      "effect": "stop",
      "source": "synthesized"
    }
  ]
}
