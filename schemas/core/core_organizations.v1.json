    {
      "key": "contact",
      "label": "Contact",
      "labelPlural": "Contacts",
      "description": "A person at an organization we deal with. EXTERNAL people only — colleagues come from the platform people directory, and leads, candidates and applicants belong to the app that runs that process.",
      "icon": "card-account-details",
      "displayField": "full_name",
      "fields": [
        {
          "key": "full_name",
          "label": "Name",
          "type": "text",
          "required": true,
          "indexed": true
        },
        {
          "key": "organization",
          "label": "Organization",
          "type": "reference",
          "targetEntity": "organization",
          "onDelete": "setNull",
          "indexed": true
        },
        {
          "key": "job_title",
