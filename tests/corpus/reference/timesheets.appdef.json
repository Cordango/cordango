{
  "schemaVersion": "2.0",
  "key": "timesheets",
  "name": "Timesheets",
  "version": "1.1.0",
  "description": "Time logging for Cordango GmbH: log hours against projects from an editable week grid, and see where the team's hours go.",
  "presentation": {
    "icon": "timer-outline",
    "color": "#0d9488",
    "category": "Operations",
    "tagline": "Hours, projects, utilization"
  },
  "uses": [
    {
      "app": "task_manager",
      "entities": [
        "project"
      ],
      "why": "hours are logged against the projects Projects owns — one project list, not a second copy"
    }
  ],
  "entities": [
    {
      "key": "time_entry",
      "label": "Time entry",
      "labelPlural": "Time entries",
      "displayField": "notes",
      "icon": "timer-outline",
      "fields": [
        {
          "key": "logged_by",
          "label": "Logged by",
          "type": "reference",
          "targetApp": "platform",
          "targetEntity": "person",
          "onDelete": "setNull",
          "help": "Who logged it. Set to the signed-in user."
        },
        {
          "key": "project",
          "label": "Project",
          "type": "reference",
          "targetEntity": "project",
          "targetApp": "task_manager",
          "required": true,
          "indexed": true
        },
        {
          "key": "entry_date",
          "label": "Date",
          "type": "date",
          "required": true,
          "indexed": true
        },
        {
          "key": "hours",
          "label": "Hours",
          "type": "decimal",
          "min": 0,
          "max": 24,
          "help": "Hours worked on this project that day. A day holds 24 of them.",
          "required": true
        },
        {
          "key": "billable",
          "label": "Billable",
          "type": "boolean",
          "default": true
        },
        {
          "key": "notes",
          "label": "Notes",
          "type": "text"
        }
      ]
    }
  ],
  "views": [
    {
      "key": "my_entries_table",
      "label": "My entries",
      "type": "table",
      "entity": "time_entry",
      "filters": [
        {
          "field": "logged_by",
          "operator": "eq",
          "value": "{{actor.id}}"
        }
      ],
      "sort": [
        {
          "field": "entry_date",
          "direction": "desc"
        }
      ],
      "config": {
        "columns": [
          "entry_date",
          "project",
          "hours",
          "billable",
          "notes"
        ]
      }
    },
    {
      "key": "all_entries_table",
      "label": "All entries",
      "type": "table",
      "entity": "time_entry",
      "sort": [
        {
          "field": "entry_date",
          "direction": "desc"
        }
      ],
      "config": {
        "columns": [
          "logged_by",
          "entry_date",
          "project",
          "hours",
          "billable",
          "notes"
        ]
      }
    }
  ],
  "pages": [
    {
      "key": "my_week",
      "label": "My week",
      "icon": "calendar-week",
      "entity": "time_entry",
      "state": [
        {
          "key": "cursor",
          "type": "date",
          "default": "{{today}}"
        }
      ],
      "blocks": [
        {
          "kind": "stack",
          "gap": "md",
          "blocks": [
            {
              "kind": "row",
              "align": "center",
              "justify": "end",
              "gap": "md",
              "blocks": [
                {
                  "kind": "control",
                  "control": "stepper",
                  "stateKey": "cursor",
                  "step": {
                    "unit": "week",
                    "amount": 1
                  }
                }
              ]
            },
            {
              "kind": "stack",
              "gap": "none",
              "blocks": [
                {
                  "kind": "row",
                  "gap": "none",
                  "blocks": [
                    {
                      "kind": "card",
                      "width": "md",
                      "padding": "sm",
                      "tone": "muted",
                      "blocks": [
                        {
                          "kind": "text",
                          "value": "Project"
                        }
                      ]
                    },
                    {
                      "kind": "repeat",
                      "as": "hcol",
                      "direction": "row",
                      "source": {
                        "dates": {
                          "from": "{{state.cursor}}",
                          "count": 7,
                          "step": "day"
                        }
                      },
                      "blocks": [
                        {
                          "kind": "card",
                          "width": "sm",
                          "padding": "sm",
                          "tone": "muted",
                          "blocks": [
                            {
                              "kind": "text",
                              "value": "{{hcol.label}}"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "kind": "repeat",
                  "as": "proj",
                  "direction": "column",
                  "source": {
                    "app": "task_manager",
                    "entity": "project",
                    "filters": [
                      {
                        "field": "status",
                        "operator": "neq",
                        "value": "completed"
                      }
                    ],
                    "sort": [
                      {
                        "field": "name",
                        "direction": "asc"
                      }
                    ]
                  },
                  "emptyText": "No live projects in Projects yet.",
                  "blocks": [
                    {
                      "kind": "row",
                      "gap": "none",
                      "blocks": [
                        {
                          "kind": "card",
                          "width": "md",
                          "padding": "sm",
                          "bordered": true,
                          "tint": "status",
                          "blocks": [
                            {
                              "kind": "field",
                              "field": "name",
                              "weight": "medium"
                            },
                            {
                              "kind": "row",
                              "gap": "sm",
                              "align": "center",
                              "blocks": [
                                {
                                  "kind": "chip",
                                  "field": "status"
                                },
                                {
                                  "kind": "field",
                                  "field": "due_date",
                                  "size": "sm",
                                  "grow": true
                                }
                              ]
                            },
                            {
                              "kind": "field",
                              "field": "lead",
                              "size": "sm"
                            },
                            {
                              "kind": "progress",
                              "label": "Tasks done",
                              "field": "done_tasks",
                              "max": "total_tasks"
                            }
                          ],
                          "openDetail": true,
                          "gap": "sm"
                        },
                        {
                          "kind": "repeat",
                          "as": "day",
                          "direction": "row",
                          "source": {
                            "dates": {
                              "from": "{{state.cursor}}",
                              "count": 7,
                              "step": "day"
                            }
                          },
                          "blocks": [
                            {
                              "kind": "card",
                              "width": "sm",
                              "padding": "xs",
                              "bordered": true,
                              "blocks": [
                                {
                                  "kind": "cell",
                                  "entity": "time_entry",
                                  "field": "hours",
                                  "editable": true,
                                  "openDetail": true,
                                  "placeholder": "",
                                  "keys": {
                                    "project": "{{proj.id}}",
                                    "entry_date": "{{day.date}}",
                                    "logged_by": "{{actor.id}}"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "key": "team",
      "label": "Team",
      "icon": "account-group",
      "entity": "time_entry",
      "blocks": [
        {
          "kind": "stack",
          "gap": "md",
          "blocks": [
            {
              "kind": "row",
              "gap": "md",
              "blocks": [
                {
                  "kind": "stat",
                  "label": "Total hours",
                  "icon": "timer-outline",
                  "source": {
                    "entity": "time_entry",
                    "aggregate": {
                      "op": "sum",
                      "field": "hours"
                    }
                  },
                  "link": {
                    "page": "entries"
                  }
                },
                {
                  "kind": "stat",
                  "label": "Billable hours",
                  "icon": "cash-multiple",
                  "source": {
                    "entity": "time_entry",
                    "aggregate": {
                      "op": "sum",
                      "field": "hours"
                    },
                    "filters": [
                      {
                        "field": "billable",
                        "operator": "eq",
                        "value": true
                      }
                    ]
                  },
                  "link": {
                    "page": "entries",
                    "filters": [
                      {
                        "field": "billable",
                        "operator": "eq",
                        "value": true
                      }
                    ]
                  }
                },
                {
                  "kind": "stat",
                  "label": "Entries",
                  "icon": "format-list-bulleted",
                  "source": {
                    "entity": "time_entry",
                    "aggregate": {
                      "op": "count"
                    }
                  },
                  "link": {
                    "page": "entries"
                  }
                }
              ]
            },
            {
              "kind": "columns",
              "columns": [
                [
                  {
                    "kind": "chart",
                    "chartType": "bar",
                    "label": "Hours by project",
                    "source": {
                      "entity": "time_entry",
                      "aggregate": {
                        "op": "sum",
                        "field": "hours",
                        "groupBy": "project"
                      }
                    },
                    "link": {
                      "page": "entries"
                    }
                  }
                ],
                [
                  {
                    "kind": "chart",
                    "chartType": "bar",
                    "label": "Hours by person",
                    "source": {
                      "entity": "time_entry",
                      "aggregate": {
                        "op": "sum",
                        "field": "hours",
                        "groupBy": "logged_by"
                      }
                    },
                    "link": {
                      "page": "entries"
                    }
                  }
                ]
              ]
            }
          ]
        }
      ]
    },
    {
      "key": "insights",
      "label": "Insights",
      "icon": "chart-bar",
      "entity": "time_entry",
      "blocks": [
        {
          "kind": "stack",
          "gap": "md",
          "blocks": [
            {
              "kind": "columns",
              "columns": [
                [
                  {
                    "kind": "chart",
                    "chartType": "bar",
                    "label": "Hours by month",
                    "source": {
                      "entity": "time_entry",
                      "aggregate": {
                        "op": "sum",
                        "field": "hours",
                        "groupBy": "month_of:entry_date"
                      }
                    },
                    "link": {
                      "page": "entries"
                    }
                  }
                ],
                [
                  {
                    "kind": "chart",
                    "chartType": "donut",
                    "label": "Billable hours by project",
                    "source": {
                      "entity": "time_entry",
                      "aggregate": {
                        "op": "sum",
                        "field": "hours",
                        "groupBy": "project"
                      },
                      "filters": [
                        {
                          "field": "billable",
                          "operator": "eq",
                          "value": true
                        }
                      ]
                    },
                    "link": {
                      "page": "entries"
                    }
                  }
                ]
              ]
            }
          ]
        }
      ]
    },
    {
      "key": "entries",
      "label": "All entries",
      "icon": "timer-outline",
      "entity": "time_entry",
      "blocks": [
        {
          "kind": "view",
          "view": "all_entries_table"
        }
      ]
    },
    {
      "key": "my_entries",
      "label": "My entries",
      "icon": "account-clock",
      "entity": "time_entry",
      "blocks": [
        {
          "kind": "view",
          "view": "my_entries_table"
        }
      ]
    }
  ],
  "roles": [
    {
      "key": "member",
      "name": "Member",
      "description": "Logs their own hours and sees projects.",
      "grants": [
        {
          "entity": "time_entry",
          "create": true,
          "read": true,
          "update": true
        }
      ]
    },
    {
      "key": "lead",
      "name": "Lead",
      "description": "Manages projects and everyone's time entries.",
      "grants": [
        {
          "entity": "time_entry",
          "create": true,
          "read": true,
          "update": true,
          "delete": true
        }
      ]
    },
    {
      "key": "admin",
      "name": "Administrator",
      "description": "Full access.",
      "grants": [
        {
          "entity": "*",
          "create": true,
          "read": true,
          "update": true,
          "delete": true
        }
      ]
    }
  ],
  "theme": {
    "primaryColor": "#0d9488",
    "secondaryColor": "#14b8a6",
    "font": "Inter",
    "radius": "medium",
    "density": "comfortable"
  }
}
