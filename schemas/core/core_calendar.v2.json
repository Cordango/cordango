    {
      "key": "booking_contact",
      "label": "Contact",
      "labelPlural": "Contacts",
      "displayField": "name",
      "icon": "account-outline",
      "description": "Somebody outside the workspace who booked time. Deliberately an ordinary app record and NOT a platform person: external people are not colleagues, they have no login, no seat and no grants, and minting an account per stranger would be account enumeration wearing a data model.",
      "fields": [
        {
          "key": "name",
          "label": "Name",
          "type": "text",
          "required": true,
          "indexed": true
        },
        {
          "key": "email",
          "label": "Email",
          "type": "email",
          "required": true,
          "unique": true,
          "indexed": true
        },
        {
          "key": "phone",
          "label": "Phone",
          "type": "phone"
        },
        {
          "key": "company",
          "label": "Company",
          "type": "text"
        },
        {
          "key": "first_seen_at",
          "label": "First booked",
          "type": "datetime"
        }
      ]
    },
    {
      "key": "booking",
      "label": "Booking",
      "labelPlural": "Bookings",
      "displayField": "summary",
      "icon": "calendar-check",
      "description": "One appointment somebody booked through a public page. Stays 'pending' until the emailed link is clicked — which is both correct behaviour and the strongest cheap defence there is, because it costs a spammer a working mailbox per attempt.",
      "unique": [
        [
          "page",
          "starts_at"
        ]
      ],
      "fields": [
        {
          "key": "summary",
          "label": "Summary",
          "type": "text",
          "required": true,
          "indexed": true,
          "help": "Who and when, in one line. Written by the server so a booking reads as something in every list without a join."
        },
        {
          "key": "page",
          "label": "Booking page",
          "type": "reference",
          "required": true,
          "indexed": true,
          "targetEntity": "booking_page",
          "onDelete": "cascade"
        },
        {
          "key": "contact",
          "label": "Booked by",
          "type": "reference",
          "required": true,
          "indexed": true,
          "targetEntity": "booking_contact",
          "onDelete": "restrict"
        },
        {
          "key": "starts_at",
          "label": "Starts",
          "type": "datetime",
          "required": true,
          "indexed": true,
          "role": "start"
        },
        {
          "key": "ends_at",
          "label": "Ends",
          "type": "datetime",
          "required": true,
          "indexed": true
        },
        {
          "key": "status",
          "label": "Status",
          "type": "select",
          "required": true,
          "default": "pending",
          "indexed": true,
          "role": "status",
          "options": [
            {
              "value": "pending",
              "label": "Awaiting confirmation",
              "color": "#f59e0b"
            },
            {
              "value": "confirmed",
              "label": "Confirmed",
              "color": "#16a34a"
            },
            {
              "value": "cancelled",
              "label": "Cancelled",
              "color": "#94a3b8"
            }
          ]
        },
        {
          "key": "note",
          "label": "Note",
          "type": "longtext",
          "help": "What the visitor typed when booking."
        },
        {
          "key": "visitor_time_zone",
          "label": "Visitor time zone",
          "type": "text",
          "group": "Details"
        },
        {
          "key": "confirmed_at",
          "label": "Confirmed",
          "type": "datetime",
          "group": "Details"
        },
        {
          "key": "cancelled_at",
          "label": "Cancelled",
          "type": "datetime",
          "group": "Details"
        },
        {
          "key": "write_back_state",
          "label": "In calendar",
          "type": "select",
          "default": "pending",
          "group": "Sync",
          "options": [
            {
              "value": "not_applicable",
              "label": "Not applicable",
              "color": "#94a3b8"
            },
            {
              "value": "pending",
              "label": "Pending",
              "color": "#f59e0b"
            },
            {
              "value": "done",
              "label": "Created",
              "color": "#16a34a"
            },
            {
              "value": "failed",
              "label": "Failed",
              "color": "#dc2626"
            }
          ],
          "help": "A failure here never un-books anybody: the visitor has already been told they are booked, so the owner is told to add it by hand instead."
        },
        {
          "key": "write_back_error",
          "label": "Write-back error",
          "type": "longtext",
          "group": "Sync"
        },
        {
          "key": "external_event_id",
          "label": "External event id",
          "type": "text",
          "indexed": true,
          "group": "Sync"
        }
      ]
    }
  ],
  "relations": [
    {
      "key": "calendar_events",
      "label": "Events",
      "type": "oneToMany",
      "fromEntity": "calendar_source",
      "toEntity": "calendar_event",
      "inverseField": "calendar"
    }
  ],
  "pages": [
    {
      "key": "my_day",
      "label": "My day",
      "icon": "calendar-today",
      "entity": "calendar_event",
      "detailFull": true,
      "blocks": [
        {
          "kind": "calendar",
          "range": "day",
          "startField": "starts_at",
          "endField": "ends_at",
          "labelField": "title",
          "colorField": "show_as",
          "openDetail": true,
          "timeAxis": {
            "startHour": 7,
            "endHour": 21,
            "slotMinutes": 30
          },
          "source": {
            "entity": "calendar_event",
            "filters": [
              {
                "field": "is_cancelled",
                "operator": "neq",
                "value": true
              }
            ],
            "sort": [
              {
                "field": "starts_at",
                "direction": "asc"
              }
            ]
          },
          "allowCreate": true,
          "quickAdd": {
            "fields": [
              "location",
              "meeting_url",
              "description"
            ],
            "children": [
              {
                "entity": "event_guest",
                "via": "event",
                "childType": "chips"
              }
            ]
          }
        }
      ]
    },
    {
      "key": "bookings",
      "label": "Bookings",
      "icon": "calendar-check",
      "entity": "booking",
      "detailFull": true,
      "state": [
        {
          "key": "status",
          "type": "text",
          "default": ""
        }
      ],
      "blocks": [
        {
          "kind": "stack",
          "gap": "md",
          "blocks": [
            {
              "kind": "filterbar",
              "entity": "booking",
              "facets": [
                {
                  "state": "status",
                  "field": "status"
                }
              ]
            },
            {
              "kind": "table",
              "openDetail": true,
              "fields": [
                "summary",
                "starts_at",
                "status",
                "page",
                "contact"
              ],
              "source": {
                "entity": "booking",
                "sort": [
                  {
                    "field": "starts_at",
                    "direction": "asc"
                  }
                ],
                "filters": [
                  {
                    "field": "status",
                    "operator": "eq",
                    "value": "{{state.status}}",
                    "optional": true
                  }
                ]
              },
              "newButton": true
            }
          ]
        }
      ]
    },
    {
      "key": "booking_pages",
      "label": "Booking pages",
      "icon": "calendar-account",
      "entity": "booking_page",
      "detailFull": true,
      "blocks": [
        {
          "kind": "table",
          "newButton": true,
          "openDetail": true,
          "fields": [
            "name",
            "slug",
            "owner",
            "duration_minutes",
            "is_published"
          ],
          "source": {
            "entity": "booking_page",
            "sort": [
              {
                "field": "name",
                "direction": "asc"
              }
            ]
          }
        }
      ]
    },
    {
      "key": "calendars",
      "label": "Calendars",
      "icon": "calendar",
      "entity": "calendar_source",
      "detailFull": true,
      "blocks": [
        {
          "kind": "table",
          "openDetail": true,
          "fields": [
            "name",
            "provider",
            "is_visible",
            "sync_status",
            "last_synced_at"
          ],
          "source": {
            "entity": "calendar_source",
            "filters": [
              {
                "field": "owner",
                "operator": "eq",
                "value": "{{actor.id}}"
              }
            ],
            "sort": [
              {
                "field": "name",
                "direction": "asc"
              }
            ]
          }
        }
      ]
    }
  ],
  "processes": [],
  "commands": [
    {
      "key": "publish",
      "label": "Publish",
      "icon": "earth",
      "entity": "booking_page",
      "description": "Make the link answer. Until it is published the address behaves as if the page did not exist.",
      "placements": [
        "recordHeader",
        "tableRow"
      ],
      "style": "primary",
      "when": {
        "field": "is_published",
        "operator": "neq",
        "value": true
      },
      "effects": [
        {
          "type": "updateRecord",
          "set": {
            "is_published": true
          }
        }
      ],
      "successMessage": "Published — the link is live."
    },
    {
      "key": "unpublish",
      "label": "Unpublish",
      "icon": "earth-off",
      "entity": "booking_page",
      "description": "Stop taking bookings. Appointments already made are untouched — this only closes the door, it does not cancel anybody.",
      "placements": [
        "recordHeader",
        "tableRow"
      ],
      "when": {
        "field": "is_published",
        "operator": "eq",
        "value": true
      },
      "effects": [
        {
          "type": "updateRecord",
          "set": {
            "is_published": false
          }
        }
      ],
      "successMessage": "Unpublished — the link no longer answers."
    }
  ],
  "roles": [
    {
      "key": "member",
      "name": "Member",
      "description": "Keeps their own calendar: creates, edits and deletes their own appointments and invites guests, and runs their own booking pages. The sync columns stay the import's — they describe a row in somebody else's system, and a hand-edited one breaks the next delta.",
      "grants": [
        {
          "entity": "calendar_source",
          "read": true
        },
        {
          "entity": "calendar_event",
          "read": true,
          "create": true,
          "update": true,
          "delete": true,
          "fieldOverrides": [
            {
              "field": "external_id",
              "update": false
            },
            {
              "field": "external_series_id",
              "update": false
            },
            {
              "field": "external_etag",
              "update": false
            },
            {
              "field": "synced_at",
              "update": false
            }
          ]
        },
        {
          "entity": "booking_page",
          "create": true,
          "read": true,
          "update": true,
          "delete": true,
          "commands": [
            "publish",
            "unpublish"
          ]
        },
        {
          "entity": "booking",
          "read": true,
          "update": true
        },
        {
          "entity": "booking_contact",
          "read": true
        },
        {
          "entity": "event_guest",
          "create": true,
          "read": true,
          "update": true,
          "delete": true
        }
      ]
    },
    {
      "key": "admin",
      "name": "Administrator",
      "description": "Manages every workspace calendar and booking page. The sync columns are read-only here too: that is a property of the data, not of the role.",
      "grants": [
        {
          "entity": "calendar_source",
          "create": true,
          "read": true,
          "update": true,
          "delete": true
        },
        {
          "entity": "calendar_event",
          "read": true,
          "create": true,
          "update": true,
          "delete": true,
          "fieldOverrides": [
            {
              "field": "external_id",
              "update": false
            },
            {
              "field": "external_series_id",
              "update": false
            },
            {
              "field": "external_etag",
              "update": false
            },
            {
              "field": "synced_at",
              "update": false
            }
          ]
        },
        {
          "entity": "booking_page",
          "create": true,
          "read": true,
          "update": true,
          "delete": true,
          "commands": [
            "publish",
            "unpublish"
          ]
        },
        {
          "entity": "booking",
          "create": true,
          "read": true,
          "update": true,
          "delete": true
        },
        {
          "entity": "booking_contact",
          "create": true,
          "read": true,
          "update": true,
          "delete": true
        },
        {
          "entity": "event_guest",
          "create": true,
          "read": true,
          "update": true,
          "delete": true
        }
      ]
    }
  ]
}
