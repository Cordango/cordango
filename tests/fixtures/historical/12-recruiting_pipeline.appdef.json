          "department",
          "title"
        ]
      }
    },
    {
      "key": "recruiters_table",
      "label": "Recruiters",
      "type": "table",
      "entity": "recruiter",
      "sort": [
        {
          "field": "full_name",
          "direction": "asc"
        }
      ],
      "config": {
        "columns": [
          "full_name",
          "email",
          "title"
        ]
      }
    },
    {
      "key": "recruiting_dashboard",
      "label": "Dashboard",
      "type": "dashboard",
      "entity": "candidate",
      "config": {
        "widgets": [
          {
            "type": "stat",
            "label": "Total Candidates",
            "entity": "candidate"
          },
          {
            "type": "stat",
            "label": "Open Positions",
            "entity": "job_opening",
            "filter": {
              "field": "opening_status",
              "operator": "eq",
              "value": "open"
            }
          },
          {
            "type": "stat",
            "label": "Pending Offers",
            "entity": "offer",
            "filter": {
              "field": "offer_status",
              "operator": "in",
              "value": [
                "draft",
                "sent",
                "negotiating"
              ]
            }
          },
          {
            "type": "breakdown",
            "label": "Candidates by Stage",
            "entity": "candidate",
            "groupBy": "stage"
          }
        ]
      }
    }
  ],
  "workflows": [
    {
      "key": "notify_recruiter_new_candidate",
      "name": "Notify Recruiter on New Candidate",
      "enabled": true,
      "trigger": {
        "event": "record.created",
        "entity": "candidate"
      },
      "actions": [
        {
          "type": "notify"
        },
        {
          "type": "email"
        }
      ]
    },
    {
      "key": "notify_hiring_manager_new_offer",
      "name": "Notify Hiring Manager When Offer Drafted",
      "enabled": true,
      "trigger": {
        "event": "record.created",
        "entity": "offer"
      },
      "actions": [
        {
          "type": "notify"
        },
        {
          "type": "email"
        }
      ]
    },
    {
      "key": "candidate_stage_to_hired",
      "name": "Auto-set Stage to Hired on Offer Acceptance",
      "enabled": true,
      "trigger": {
        "event": "field.changed",
        "entity": "offer",
        "field": "offer_status"
      },
      "conditions": [
        {
          "field": "offer_status",
          "operator": "eq",
          "value": "accepted"
        }
      ],
      "actions": [
        {
          "type": "updateField"
        }
      ]
    },
    {
      "key": "notify_candidate_offer_sent",
      "name": "Email Candidate When Offer Is Sent",
      "enabled": true,
      "trigger": {
        "event": "field.changed",
        "entity": "offer",
        "field": "offer_status"
      },
      "conditions": [
        {
          "field": "offer_status",
          "operator": "eq",
          "value": "sent"
        }
      ],
      "actions": [
        {
          "type": "email"
        },
        {
          "type": "notify"
        }
      ]
    },
    {
      "key": "reminder_upcoming_interviews",
      "name": "Daily Upcoming Interview Reminder",
      "enabled": true,
      "trigger": {
        "event": "schedule",
        "entity": "interview",
        "cron": "0 8 * * *"
      },
      "conditions": [
        {
          "field": "interview_status",
          "operator": "eq",
          "value": "scheduled"
        }
      ],
      "actions": [
        {
          "type": "notify"
        },
        {
          "type": "email"
        }
      ]
    }
  ],
