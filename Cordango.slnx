<!--
  THE EXTRACTION TEST, as a runnable command rather than a claim.

      dotnet test Cordango.slnx

  must pass in a plain clone of this repository: no database, no containers, no platform, nothing
  from the private monorepo this code was lifted out of. That is the whole promise of an open
  toolchain, so it is a command rather than a paragraph.

  Run it alongside the private suite in every slice. It is seconds, and it is the only check that
  notices the boundary eroding before somebody actually tries to build from a fresh clone.
-->
<Solution>
  <Project Path="src/Cordango.Compiler/Cordango.Compiler.csproj" />
  <Project Path="src/Cordango.Cli/Cordango.Cli.csproj" />
  <Project Path="src/Cordango.SourceGen/Cordango.SourceGen.csproj" />
  <Project Path="src/Cordango.SourceGen.Common/Cordango.SourceGen.Common.csproj" />
  <Project Path="src/Cordango.SourceGen.DotNetVue/Cordango.SourceGen.DotNetVue.csproj" />
  <Project Path="src/Cordango.Standalone/Cordango.Standalone.csproj" />
  <Project Path="tests/Compiler.Tests/Cordango.Compiler.Tests.csproj" />
  <Project Path="tests/Compatibility.Tests/Cordango.Compatibility.Tests.csproj" />
  <Project Path="tests/Determinism.Tests/Cordango.Determinism.Tests.csproj" />
  <Project Path="tests/Cli.Tests/Cordango.Cli.Tests.csproj" />
  <Project Path="tests/Standalone.Tests/Cordango.Standalone.Tests.csproj" />
</Solution>
