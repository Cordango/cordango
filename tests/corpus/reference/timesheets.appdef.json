{
  "schemaVersion": "2.0",
  "key": "timesheets",
  "name": "Timesheets",
  "version": "1.2.0",
  "description": "Time logging for Cordango GmbH: log hours against projects from an editable week grid - several entries a day, each with its activity - and see where the team's hours go.",
  "presentation": {
    "icon": "timer-outline",
    "color": "#0d9488",
    "category": "Operations",
    "tagline": "Hours, projects, utilization"
  },
  "uses": [
    {
      "app": "task_manager",
      "entities": [
        "project",
        "task"
      ],
      "why": "hours are logged against the projects Projects owns - one project list, not a second copy - and the week counts the tasks the person has finished there"
    },
    {
      "app": "core_people",
      "entities": [
        "employee"
      ],
      "why": "a person's weekly hours are their target for the week; nobody should type it twice"
    }
  ],
  "entities": [
    {
      "key": "time_entry",
      "label": "Time entry",
      "labelPlural": "Time entries",
      "displayField": "notes",
      "icon": "timer-outline",
      "fields": [
        {
          "key": "logged_by",
          "label": "Logged by",
          "type": "reference",
          "targetApp": "platform",
          "targetEntity": "person",
          "onDelete": "setNull",
          "help": "Who logged it. Set to the signed-in user."
        },
        {
          "key": "project",
          "label": "Project",
          "type": "reference",
          "targetEntity": "project",
          "targetApp": "task_manager",
          "required": true,
          "indexed": true
        },
        {
          "key": "entry_date",
          "label": "Date",
          "type": "date",
          "required": true,
          "indexed": true
        },
        {
          "key": "hours",
          "label": "Hours",
          "type": "decimal",
          "min": 0,
          "max": 24,
          "help": "Hours worked on this project that day. A day holds 24 of them.",
          "required": true,
          "scale": 1,
          "unit": " h"
        },
        {
          "key": "activity",
          "label": "Activity",
          "type": "select",
          "help": "What the time went on. Reported by project and by activity, so the week shows the split.",
          "options": [
            {
              "value": "development",
              "label": "Development",
              "color": "#3b82f6",
              "icon": "code-tags"
            },
            {
              "value": "design",
              "label": "Design",
              "color": "#a855f7",
              "icon": "palette-outline"
            },
            {
              "value": "meeting",
              "label": "Meeting",
              "color": "#f59e0b",
              "icon": "account-group-outline"
            },
            {
              "value": "research",
              "label": "Research",
              "color": "#14b8a6",
              "icon": "magnify"
            },
            {
              "value": "planning",
              "label": "Planning",
              "color": "#6366f1",
              "icon": "calendar-check-outline"
            },
            {
              "value": "review",
              "label": "Review",
              "color": "#0ea5e9",
              "icon": "eye-check-outline"
            },
            {
              "value": "admin",
              "label": "Admin",
              "color": "#64748b",
              "icon": "briefcase-outline"
            },
            {
              "value": "other",
              "label": "Other",
              "color": "#94a3b8",
              "icon": "dots-horizontal"
            }
          ]
        },
        {
          "key": "billable",
          "label": "Billable",
          "type": "boolean",
          "default": true
        },
        {
          "key": "notes",
          "label": "Notes",
          "type": "text"
        }
      ]
    }
  ],
  "views": [
    {
      "key": "my_entries_table",
      "label": "My entries",
      "type": "table",
      "entity": "time_entry",
      "filters": [
        {
          "field": "logged_by",
          "operator": "eq",
          "value": "{{actor.id}}"
        }
      ],
      "sort": [
        {
          "field": "entry_date",
          "direction": "desc"
        }
      ],
      "config": {
        "columns": [
          "entry_date",
          "project",
          "hours",
          "billable",
          "activity",
          "notes"
        ]
      }
    },
    {
      "key": "all_entries_table",
      "label": "All entries",
      "type": "table",
      "entity": "time_entry",
      "sort": [
        {
          "field": "entry_date",
          "direction": "desc"
        }
      ],
      "config": {
        "columns": [
          "logged_by",
          "entry_date",
          "project",
          "hours",
          "billable",
          "activity",
          "notes"
        ]
      }
    }
  ],
  "pages": [
    {
      "key": "my_week",
      "label": "My week",
      "icon": "calendar-week",
      "entity": "time_entry",
      "state": [
        {
          "key": "week",
          "type": "period",
          "default": "thisWeek"
        }
      ],
      "blocks": [
        {
          "kind": "stack",
          "gap": "md",
          "blocks": [
            {
              "kind": "period",
              "stateKey": "week",
              "units": [
                "week"
              ]
            },
            {
              "kind": "row",
              "align": "center",
              "gap": "md",
              "wrap": true,
              "blocks": [
                {
                  "kind": "tiles",
                  "tiles": [
                    {
                      "label": "Hours logged",
                      "icon": "clock-outline",
                      "color": "primary",
                      "source": {
                        "entity": "time_entry",
                        "aggregate": {
                          "op": "sum",
                          "field": "hours"
                        },
                        "filters": [
                          {
                            "field": "logged_by",
                            "operator": "eq",
                            "value": "{{actor.id}}"
                          },
                          {
                            "field": "entry_date",
                            "operator": "gte",
                            "value": "{{state.week.from}}"
                          },
                          {
                            "field": "entry_date",
                            "operator": "lt",
                            "value": "{{state.week.next}}"
                          }
                        ]
                      },
                      "max": {
                        "source": {
                          "app": "core_people",
                          "entity": "employee",
                          "aggregate": {
                            "op": "sum",
                            "field": "weekly_hours"
                          },
                          "filters": [
                            {
                              "field": "person",
                              "operator": "eq",
                              "value": "{{actor.id}}"
                            }
                          ]
                        }
                      }
                    },
                    {
                      "label": "Billable hours",
                      "icon": "cash-multiple",
                      "color": "success",
                      "showMax": false,
                      "meter": "none",
                      "caption": "{{tile.pct}} of your hours",
                      "source": {
                        "entity": "time_entry",
                        "aggregate": {
                          "op": "sum",
                          "field": "hours"
                        },
                        "filters": [
                          {
                            "field": "logged_by",
                            "operator": "eq",
                            "value": "{{actor.id}}"
                          },
                          {
                            "field": "billable",
                            "operator": "eq",
                            "value": true
                          },
                          {
                            "field": "entry_date",
                            "operator": "gte",
                            "value": "{{state.week.from}}"
                          },
                          {
                            "field": "entry_date",
                            "operator": "lt",
                            "value": "{{state.week.next}}"
                          }
                        ]
                      },
                      "max": {
                        "source": {
                          "entity": "time_entry",
                          "aggregate": {
                            "op": "sum",
                            "field": "hours"
                          },
                          "filters": [
                            {
                              "field": "logged_by",
                              "operator": "eq",
                              "value": "{{actor.id}}"
                            },
                            {
                              "field": "entry_date",
                              "operator": "gte",
                              "value": "{{state.week.from}}"
                            },
                            {
                              "field": "entry_date",
                              "operator": "lt",
                              "value": "{{state.week.next}}"
                            }
                          ]
                        }
                      }
                    },
                    {
                      "label": "Projects",
                      "icon": "folder-outline",
                      "color": "info",
                      "caption": "With hours in this week",
                      "source": {
                        "entity": "time_entry",
                        "aggregate": {
                          "op": "countDistinct",
                          "field": "project"
                        },
                        "filters": [
                          {
                            "field": "logged_by",
                            "operator": "eq",
                            "value": "{{actor.id}}"
                          },
                          {
                            "field": "entry_date",
                            "operator": "gte",
                            "value": "{{state.week.from}}"
                          },
                          {
                            "field": "entry_date",
                            "operator": "lt",
                            "value": "{{state.week.next}}"
                          }
                        ]
                      }
                    },
                    {
                      "label": "Tasks",
                      "icon": "checkbox-marked-circle-outline",
                      "color": "success",
                      "meter": "none",
                      "caption": "Done, of those assigned to you",
                      "source": {
                        "app": "task_manager",
                        "entity": "task",
                        "aggregate": {
                          "op": "count"
                        },
                        "filters": [
                          {
                            "field": "assignee",
                            "operator": "eq",
                            "value": "{{actor.id}}"
                          },
                          {
                            "field": "status",
                            "operator": "eq",
                            "value": "done"
                          }
                        ]
                      },
                      "max": {
                        "source": {
                          "app": "task_manager",
                          "entity": "task",
                          "aggregate": {
                            "op": "count"
                          },
                          "filters": [
                            {
                              "field": "assignee",
                              "operator": "eq",
                              "value": "{{actor.id}}"
                            }
                          ]
                        }
                      }
                    }
                  ],
                  "grow": true
                },
                {
                  "kind": "create",
                  "entity": "time_entry",
                  "label": "Add time entry",
                  "style": "primary",
                  "icon": "plus"
                }
              ]
            },
            {
              "kind": "matrix",
              "source": {
                "entity": "time_entry",
                "aggregate": {
                  "op": "sum",
                  "field": "hours"
                },
                "filters": [
                  {
                    "field": "logged_by",
                    "operator": "eq",
                    "value": "{{actor.id}}"
                  }
                ]
              },
              "rowBy": "project",
              "rowSource": {
                "app": "task_manager",
                "entity": "project",
                "filters": [
                  {
                    "field": "status",
                    "operator": "neq",
                    "value": "completed"
                  }
                ],
                "sort": [
                  {
                    "field": "name",
                    "direction": "asc"
                  }
                ]
              },
              "blocks": [
                {
                  "kind": "card",
                  "padding": "sm",
                  "bordered": true,
                  "tint": "status",
                  "blocks": [
                    {
                      "kind": "field",
                      "field": "name",
                      "weight": "medium"
                    },
                    {
                      "kind": "row",
                      "gap": "sm",
                      "align": "center",
                      "blocks": [
                        {
                          "kind": "chip",
                          "field": "status"
                        },
                        {
                          "kind": "field",
                          "field": "due_date",
                          "size": "sm",
                          "grow": true
                        }
                      ]
                    },
                    {
                      "kind": "field",
                      "field": "lead",
                      "size": "sm"
                    },
                    {
                      "kind": "progress",
                      "label": "Tasks done",
                      "field": "done_tasks",
                      "max": "total_tasks"
                    }
                  ],
                  "openDetail": true,
                  "gap": "none"
                }
              ],
              "columnBy": "entry_date",
              "columnSource": {
                "dates": {
                  "from": "{{state.week.from}}",
                  "to": "{{state.week.to}}",
                  "step": "day"
                }
              },
              "totals": {
                "rows": true,
                "columns": true,
                "share": true
              },
              "entries": {
                "fields": [
                  "activity",
                  "notes"
                ]
              },
              "editable": true,
              "openDetail": true,
              "emptyText": "No live projects in Projects yet."
            }
          ]
        }
      ],
      "subtitle": "Your hours, project by project and day by day. Click a day to add time; click a figure to change it."
    },
    {
      "key": "team",
      "label": "Team",
      "icon": "account-group",
      "entity": "time_entry",
      "blocks": [
        {
          "kind": "stack",
          "gap": "md",
          "blocks": [
            {
              "kind": "row",
              "gap": "md",
              "blocks": [
                {
                  "kind": "stat",
                  "label": "Total hours",
                  "icon": "timer-outline",
                  "source": {
                    "entity": "time_entry",
                    "aggregate": {
                      "op": "sum",
                      "field": "hours"
                    }
                  },
                  "link": {
                    "page": "entries"
                  }
                },
                {
                  "kind": "stat",
                  "label": "Billable hours",
                  "icon": "cash-multiple",
                  "source": {
                    "entity": "time_entry",
                    "aggregate": {
                      "op": "sum",
                      "field": "hours"
                    },
                    "filters": [
                      {
                        "field": "billable",
                        "operator": "eq",
                        "value": true
                      }
                    ]
                  },
                  "link": {
                    "page": "entries",
                    "filters": [
                      {
                        "field": "billable",
                        "operator": "eq",
                        "value": true
                      }
                    ]
                  }
                },
                {
                  "kind": "stat",
                  "label": "Entries",
                  "icon": "format-list-bulleted",
                  "source": {
                    "entity": "time_entry",
                    "aggregate": {
                      "op": "count"
                    }
                  },
                  "link": {
                    "page": "entries"
                  }
                }
              ]
            },
            {
              "kind": "columns",
              "columns": [
                [
                  {
                    "kind": "chart",
                    "chartType": "bar",
                    "label": "Hours by project",
                    "source": {
                      "entity": "time_entry",
                      "aggregate": {
                        "op": "sum",
                        "field": "hours",
                        "groupBy": "project"
                      }
                    },
                    "link": {
                      "page": "entries"
                    }
                  }
                ],
                [
                  {
                    "kind": "chart",
                    "chartType": "bar",
                    "label": "Hours by person",
                    "source": {
                      "entity": "time_entry",
                      "aggregate": {
                        "op": "sum",
                        "field": "hours",
                        "groupBy": "logged_by"
                      }
                    },
                    "link": {
                      "page": "entries"
                    }
                  }
                ]
              ]
            }
          ]
        }
      ]
    },
    {
      "key": "insights",
      "label": "Insights",
      "icon": "chart-bar",
      "entity": "time_entry",
      "blocks": [
        {
          "kind": "stack",
          "gap": "md",
          "blocks": [
            {
              "kind": "columns",
              "columns": [
                [
                  {
                    "kind": "chart",
                    "chartType": "bar",
                    "label": "Hours by month",
                    "source": {
                      "entity": "time_entry",
                      "aggregate": {
                        "op": "sum",
                        "field": "hours",
                        "groupBy": "month_of:entry_date"
                      }
                    },
                    "link": {
                      "page": "entries"
                    }
                  }
                ],
                [
                  {
                    "kind": "chart",
                    "chartType": "donut",
                    "label": "Billable hours by project",
                    "source": {
                      "entity": "time_entry",
                      "aggregate": {
                        "op": "sum",
                        "field": "hours",
                        "groupBy": "project"
                      },
                      "filters": [
                        {
                          "field": "billable",
                          "operator": "eq",
                          "value": true
                        }
                      ]
                    },
                    "link": {
                      "page": "entries"
                    }
                  }
                ]
              ]
            }
          ]
        }
      ]
    },
    {
      "key": "entries",
      "label": "All entries",
      "icon": "timer-outline",
      "entity": "time_entry",
      "blocks": [
        {
          "kind": "view",
          "view": "all_entries_table"
        }
      ]
    },
    {
      "key": "my_entries",
      "label": "My entries",
      "icon": "account-clock",
      "entity": "time_entry",
      "blocks": [
        {
          "kind": "view",
          "view": "my_entries_table"
        }
      ]
    }
  ],
  "roles": [
    {
      "key": "member",
      "name": "Member",
      "description": "Logs their own hours and sees projects.",
      "grants": [
        {
          "entity": "time_entry",
          "create": true,
          "read": true,
          "update": true
        }
      ]
    },
    {
      "key": "lead",
      "name": "Lead",
      "description": "Manages projects and everyone's time entries.",
      "grants": [
        {
          "entity": "time_entry",
          "create": true,
          "read": true,
          "update": true,
          "delete": true
        }
      ]
    },
    {
      "key": "admin",
      "name": "Administrator",
      "description": "Full access.",
      "grants": [
        {
          "entity": "*",
          "create": true,
          "read": true,
          "update": true,
          "delete": true
        }
      ]
    }
  ],
  "theme": {
    "primaryColor": "#0d9488",
    "secondaryColor": "#14b8a6",
    "font": "Inter",
    "radius": "medium",
    "density": "comfortable"
  }
}
