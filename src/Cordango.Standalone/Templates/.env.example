# Copy to .env and fill in. .env is gitignored; keep it that way.

# The database password. There is a local-only default, so `docker compose up` works with nothing
# set — the db service publishes no port, so only the app container can reach it. Set a real one
# before this runs anywhere but your machine.
DB_PASSWORD=

# The first administrator. LEAVE BOTH EMPTY and the application asks you to create the account on
# the first screen you see — which is the normal way in, and means nobody is handed a password they
# did not choose.
#
# Fill them in for an unattended deployment: the account then exists before anything can reach the
# application, and the setup screen never appears. Do that anywhere the first request will not be
# yours. After an administrator exists these are ignored, and they never reset a password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Where uploads and the cookie key ring live inside the container. The compose file puts a volume
# on /appdata, so both survive a rebuild; there is no reason to change these unless you move the
# volume.
#
# The port the application is published on.
#
# Every generated application defaults to 8080, so the SECOND one you start on a machine will fail
# to bind and say so. Its containers and its database are already separate — the compose file names
# the project after the application — but a port can only belong to one of them. Give the second a
# different number here.
PORT=8080

# Load the generated demo dataset on a fresh database. Set to false for a real deployment.
SEED=true

# Set to "today" to re-anchor the demo dates on the day it loads. The dataset is otherwise
# reproducible: the same build always produces the same rows on the same dates.
SEED_DATE=
