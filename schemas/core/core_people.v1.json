  "processes": [],
  "commands": [
    {
      "key": "mark_inactive",
      "label": "Disable",
      "icon": "account-off-outline",
      "entity": "employee",
      "style": "danger",
      "description": "Mark this employee inactive (alumni) — they leave the active team but stay in the directory.",
      "placements": [
        "recordHeader"
      ],
      "when": {
        "field": "employment_status",
        "operator": "neq",
        "value": "alumni"
      },
      "confirm": {
        "title": "Disable this employee?",
        "message": "Sets their status to Alumni. They drop off the active Team view but remain searchable in the Directory. Use Offboard first if there is an exit process to run.",
        "tone": "danger",
        "confirmLabel": "Disable"
      },
      "effects": [
        {
          "type": "updateRecord",
          "target": "self",
          "set": {
            "employment_status": "alumni"
          }
        }
      ],
      "successMessage": "Employee disabled."
    }
  ],
