{
  "name": "{{AppSlug}}-api",
  "version": "1.0.0",
  "private": true,
  "description": "{{AppName}} — generated by Cordango, and yours from here on.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy:assets",
    "copy:assets": "node --input-type=module -e \"import{cpSync,existsSync}from'node:fs';for(const d of ['seed','resources'])if(existsSync(`src/${d}`))cpSync(`src/${d}`,`dist/${d}`,{recursive:true})\"",
    "start": "node dist/server.js",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput & node --watch dist/server.js",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cordango/standalone": "{{RuntimeVersion}}",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3"
  }
}
