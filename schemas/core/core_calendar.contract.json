        },
        {
          "key": "is_default_target",
          "label": "Default for bookings",
          "type": "boolean"
        },
        {
          "key": "feed_url",
          "label": "iCal address",
          "type": "url"
        },
        {
          "key": "feed_time_zone",
          "label": "Feed time zone",
          "type": "text"
        },
        {
          "key": "subscribe_url",
          "label": "Subscription link",
          "type": "url"
        },
        {
          "key": "external_id",
          "label": "External id",
          "type": "text"
        },
        {
          "key": "sync_status",
          "label": "Sync status",
          "type": "select",
          "options": [
            {
              "value": "ok",
              "label": "OK",
              "color": "#16a34a"
            },
            {
              "value": "needs_reauth",
