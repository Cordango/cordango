          "type": "datetime"
        },
        {
          "key": "last_error",
          "label": "Last error",
          "type": "longtext"
        }
      ]
    },
    {
      "key": "calendar_event",
      "label": "Event",
      "labelPlural": "Events",
      "description": "One appointment, at one instant, on one calendar. Recurring series arrive already EXPANDED into their individual occurrences — the provider does that expansion and applies each per-instance override, and re-deriving it from a rule would mean disagreeing with the user's own Outlook, which is the reference they will compare against.",
      "displayField": "title",
      "fields": [
        {
          "key": "title",
          "label": "Title",
          "type": "text",
          "required": true
        },
        {
          "key": "calendar",
          "label": "Calendar",
          "type": "reference",
          "required": true,
          "targetEntity": "calendar_source"
        },
        {
          "key": "starts_at",
          "label": "Starts",
          "type": "datetime",
          "required": true
        },
        {
          "key": "ends_at",
          "label": "Ends",
          "type": "datetime",
          "required": true
        },
        {
          "key": "is_all_day",
          "label": "All day",
          "type": "boolean"
        },
        {
          "key": "time_zone",
          "label": "Time zone",
          "type": "text"
        },
        {
          "key": "location",
          "label": "Location",
          "type": "text"
        },
        {
          "key": "meeting_url",
          "label": "Meeting link",
          "type": "url"
        },
        {
