          "type": "phone"
        },
        {
          "key": "is_primary",
          "label": "Primary contact",
          "type": "boolean",
          "default": false,
          "help": "The person to approach first at this organization."
        },
        {
          "key": "status",
          "label": "Status",
          "type": "select",
          "role": "status",
          "default": "active",
          "indexed": true,
          "help": "Archive a contact who has left; references from past records still resolve to their name.",
